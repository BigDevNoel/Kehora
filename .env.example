# Copy to .env and fill in. .env is git-ignored; never commit real values.
# docker compose reads this file for every service. Host-run tools (pytest, vite) read it too.

# --- Runtime -------------------------------------------------------------------------------
# dev | test | staging | prod
ENV=dev
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Database / queue (host-side URLs; compose overrides them for containers) --------------
DATABASE_URL=postgresql+psycopg://kehora:kehora@localhost:5432/kehora
REDIS_URL=redis://localhost:6379/0

# --- Object storage (local SeaweedFS S3, ADR-0002; leave S3_ENDPOINT_URL empty for AWS S3) -
S3_ENDPOINT_URL=http://localhost:8333
# Endpoint the browser can reach for signed URLs (compose containers sign with this host).
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=eu-west-1
S3_BUCKET=kehora-dev
# Any values work locally; SeaweedFS is configured from these on start.
S3_ACCESS_KEY_ID=kehora-local
S3_SECRET_ACCESS_KEY=change-me-local-only

# --- Auth: Clerk (https://dashboard.clerk.com -> your dev instance -> API keys) ------------
# Frontend API URL, e.g. https://your-app.clerk.accounts.dev (JWT issuer; JWKS is read from it)
CLERK_ISSUER=
# sk_test_...
CLERK_SECRET_KEY=
# Webhooks -> endpoint -> Signing secret (whsec_...). Endpoint URL: <api>/v1/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=
# JSON list of origins allowed as the token's `azp`
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173","http://localhost:5174"]
# pk_test_... (used by studio and admin)
VITE_CLERK_PUBLISHABLE_KEY=

# --- E2E tests ------------------------------------------------------------------------------
# Email of an existing user in the Clerk *dev* instance. Playwright signs in as this user with
# Clerk testing tokens (uses CLERK_SECRET_KEY); no password needed. Required in CI.
E2E_CLERK_USER_EMAIL=

# --- LLM gateway (ADR-0008). Not needed for `make check`, which uses the fake adapter -------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# default | test   (test routes every role to the deterministic fake adapter)
LLM_ROUTING_PROFILE=default

# --- Sandboxes (ADR-0007) ------------------------------------------------------------------
# local_docker | e2b
SANDBOX_PROVIDER=local_docker
# Only for the hosted provider (stub in Phase 0)
E2B_API_KEY=

# --- Observability (all optional) ----------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kehora-dev

# --- Frontend ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
# Public site links to the studio here
PUBLIC_STUDIO_URL=http://localhost:5173

# --- Feature flags (FEATURE_<NAME>=true|false; defaults in kehora_common/flags.py) --------
FEATURE_CREDITS_ENFORCED=false
